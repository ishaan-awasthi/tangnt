{/* Top Section: Logo, Expand/Collapse */}
        <div className="relative flex flex-col items-center pb-[20px] pl-[16px]">
          {/* Logo and Expand/Collapse Button */}
          <div className="flex items-center justify-between w-full px-2">
            <div className="flex items-center justify-center w-14 h-14 bg-[#232329] rounded-xl pt-[14px]">
              {/* Tangnt Logo Lucide Icon (using Hexagon as placeholder) */}
              <Hexagon size={24} className="text-gray-100" />
            </div>
            {isExpanded && (
              <span
                className="ml-auto p-1 text-gray-400 hover:text-gray-200 cursor-pointer"
                onClick={() => setIsExpanded(false)}
                aria-label="Collapse sidebar"
              >
                <ChevronLeft size={20} />
              </span>
            )}
          </div>
          {/* Expand Button (when collapsed, appears on logo hover) */}
          {!isExpanded && (
            <span
              className="absolute text-gray-400 hover:text-gray-200 bg-[#232329] rounded-full cursor-pointer"
              onClick={() => setIsExpanded(true)}
              aria-label="Expand sidebar"
            >
              <ChevronRight size={20} />
            </span>
          )}
        </div>